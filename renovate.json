{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "This repo is PUBLIC and spotship/.github is PRIVATE, so it cannot extend the",
    "org preset -- `github>spotship/.github` does not resolve here. This file is",
    "hand-maintained and must be kept in step with default.json by hand.",
    "",
    "`:semanticCommitTypeAll(chore)` MUST STAY AFTER config:recommended, which",
    "pulls in :semanticPrefixFixDepsChoreOthers and types the cargo `dependencies`",
    "depType as `fix`. Listed before it, that wins and PR titles stay `fix(deps)`.",
    "Both entries below are Renovate built-ins, which is why they resolve in a",
    "public repo when the org preset does not."
  ],
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitTypeAll(chore)",
    ":enablePreCommit"
  ],
  "timezone": "UTC",
  "schedule": ["* * * * 5"],
  "dependencyDashboard": true,
  "baseBranchPatterns": ["main"],
  "rangeStrategy": "bump",
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 5"]
  },
  "separateMajorMinor": true,
  "packageRules": [
    {
      "description": "Keep spotship/.github reusable workflow uses on main; never hash-pin",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["spotship/.github"],
      "pinDigests": false
    },
    {
      "description": "Group patch+minor per ecosystem",
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "non-major dependencies ({{{datasource}}})"
    },
    {
      "description": "All GitHub Actions updates in a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "separateMajorMinor": false,
      "separateMultipleMajor": false
    },
    {
      "description": "Patch cooldown: 3 days",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Minor cooldown: 10 days",
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "10 days"
    },
    {
      "description": "Major version cooldown: 30 days",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "30 days"
    }
  ]
}
